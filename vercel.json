{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/u/:slug",
      "destination": "/invitation.html"
    },
    {
      "source": "/preview/:slug",
      "destination": "/invitation.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/admin/",
      "destination": "/admin.html"
    },
    {
      "source": "/demo/:template",
      "destination": "/invitation.html"
    },
    {
      "source": "/masuk",
      "destination": "/admin.html"
    },
    {
      "source": "/masuk/",
      "destination": "/admin.html"
    },
    {
      "source": "/akun",
      "destination": "/admin.html"
    },
    {
      "source": "/akun/",
      "destination": "/admin.html"
    }
  ],
  "functions": {
    "api/index.mjs": {
      "includeFiles": "server/migrations/*.sql",
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://res.cloudinary.com; media-src 'self' blob: https://res.cloudinary.com; frame-src 'self' https://www.google.com https://google.com https://maps.google.com; connect-src 'self' https://api.cloudinary.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
